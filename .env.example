# Required for authenticated backend routes; keep the service key server-side.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
BACKEND_API_KEY=generate-a-long-random-server-only-key
MAI_BASE_URL=https://readright-mai.reevsan.dev/v1
MAI_API_KEY=your-mai-api-key-here

# CORS — JSON array of allowed frontend origins.
ALLOWED_ORIGINS=["http://localhost:5173"]

# Deployment values used by docker-compose.yml and Caddy.
IMAGE=ghcr.io/christiannemeno/readright-api:latest
API_DOMAIN=api.readright.example.com
ACME_EMAIL=you@example.com
