# Reverse proxy + auto-HTTPS for the ReadRight API.
# $API_DOMAIN and $ACME_EMAIL come from the container environment (see docker-compose.yml).
# Caddy provisions and renews a Let's Encrypt certificate for $API_DOMAIN automatically.

{$API_DOMAIN} {
	tls {$ACME_EMAIL}

	encode gzip

	reverse_proxy api:8000

	log {
		output stdout
		format console
	}
}
